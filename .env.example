# Shared local development defaults.
APP_ENV=development

# Backend（host/port 在 scripts/dev-backend.sh 中设置，不从 .env 读取）
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./data/app.db
MODEL_PROVIDER=mock

# Model providers. Keep real keys in .env only.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BACKEND_WS_URL=ws://localhost:8000/api
